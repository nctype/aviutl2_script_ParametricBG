float4 pbg_symbol(float4 pos:SV_Position,float2 uv:TEXCOORD):SV_Target{
 float2 p=abs((uv-.5)*2);float d=0;
 if(b0.z==8)d=(p.x+p.y-1)*.70710678;
 else if(b0.z==9)d=min(max(p.x-1,p.y-b1.x),max(p.x-b1.x,p.y-1));
 else{float inner=max(b1.y,.00001)*.5;float2 q=p.x>p.y?p.yx:p;d=(q.x*(1-inner)+q.y*inner-inner)/sqrt((1-inner)*(1-inner)+inner*inner);}
 return float4(1,1,1,saturate(.5-d*min(b0.x,b0.y)*.5));
}

float4 pbg_resize(float4 pos:SV_Position,float2 uv:TEXCOORD):SV_Target{
 return input0.SampleLevel(smp,uv,0);
}

]]

--[[pixelshader@pbg_resize:
Texture2D input0:register(t0);
Texture2D input1:register(t1);
SamplerState smp:register(s0);
cbuffer args:register(b0){float4 b0;float4 b1;};
float4 packPoint(uint2 p){return float4(p.x>>8,p.x&255,p.y>>8,p.y&255)/255;}
float2 unpackPoint(float4 v){uint4 t=(uint4)round(saturate(v)*255);return float2(t.x*256+t.y,t.z*256+t.w);}
float4 packDistance(float value,float inside){uint v=(uint)round(saturate(value)*65535);return float4((v>>8)/255.0,(v&255)/255.0,inside,1);}
float distanceValue(float4 v){float2 t=round(saturate(v.rg)*255);return (t.x*256+t.y)/65535;}
bool maskAt(int2 p,bool second){
 if(any(p<0)||any(p>=(int2)b0.xy))return false;
 float4 v=second?input1.Load(int3(p,0)):input0.Load(int3(p,0));
 float mask=b0.w<.5?v.a:(1-dot(v.rgb,float3(.2126,.7152,.0722)))*v.a;
 return mask>=.5;
}
float4 pbg_seed(float4 pos:SV_Position):SV_Target{
 int2 p=(int2)pos.xy;bool center=maskAt(p,false);
 bool edge=maskAt(p+int2(1,0),false)!=center||maskAt(p+int2(-1,0),false)!=center||maskAt(p+int2(0,1),false)!=center||maskAt(p+int2(0,-1),false)!=center;
 return edge?packPoint((uint2)p):float4(1,1,1,1);
}
float4 pbg_jump(float4 pos:SV_Position):SV_Target{
 int2 p=(int2)pos.xy;float2 best=float2(65535,65535);float bestDistance=1e30;
 [unroll]for(int y=-1;y<=1;y++)[unroll]for(int x=-1;x<=1;x++){
  int2 q=p+int2(x,y)*(int)b0.z;
  if(any(q<0)||any(q>=(int2)b0.xy))continue;
  float2 candidate=unpackPoint(input0.Load(int3(q,0)));
  if(candidate.x>=65535)continue;
  float d=dot(candidate-p,candidate-p);
  if(d<bestDistance){bestDistance=d;best=candidate;}
 }
 return packPoint((uint2)best);
}
float4 pbg_distance(float4 pos:SV_Position):SV_Target{
 int2 p=(int2)pos.xy;float2 nearest=unpackPoint(input0.Load(int3(p,0)));
 float d=nearest.x>=65535?length(b0.xy):length(nearest-p);
 return packDistance(d/length(b0.xy),maskAt(p,true)?1:0);
}
float4 pbg_max(float4 pos:SV_Position):SV_Target{
 int2 p=(int2)pos.xy*2;float value=0;
 [unroll]for(int y=0;y<2;y++)[unroll]for(int x=0;x<2;x++){
  int2 q=p+int2(x,y);
  if(any(q>=(int2)b0.xy))continue;
  float4 v=input0.Load(int3(q,0));
  if(v.b>.5)value=max(value,distanceValue(v));
 }
 return packDistance(value,1);
}

float4 pbg_symbol(float4 pos:SV_Position,float2 uv:TEXCOORD):SV_Target{
 float2 p=abs((uv-.5)*2);float d=0;
 if(b0.z==8)d=(p.x+p.y-1)*.70710678;
 else if(b0.z==9)d=min(max(p.x-1,p.y-b1.x),max(p.x-b1.x,p.y-1));
 else{float inner=max(b1.y,.00001)*.5;float2 q=p.x>p.y?p.yx:p;d=(q.x*(1-inner)+q.y*inner-inner)/sqrt((1-inner)*(1-inner)+inner*inner);}
 return float4(1,1,1,saturate(.5-d*min(b0.x,b0.y)*.5));
}

float4 pbg_resize(float4 pos:SV_Position,float2 uv:TEXCOORD):SV_Target{
 return input0.SampleLevel(smp,uv,0);
}

]]
